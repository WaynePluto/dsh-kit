{
  "name": "@dsh-kit/dsh-plugin-conversation-enhancements",
  "version": "0.1.0",
  "description": "整合失败重试、聊天滚动、统计时长、消息分叉、会话重命名、复制工作区路径、收起全部工作区、通知、会话工作区显示与侧栏面板行回会话的会话增强 Bundle。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "locale"
  ],
  "dependencies": {
    "@dsh-kit/dsh-plugin-turn-retry": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-chat-scroll": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-stats-hours": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-user-message-fork": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-session-rename": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-workspace-path": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-workspace-collapse": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-notify": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-session-workspace": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-panel-toggle": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-session-park": "workspace:0.1.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  }
}
