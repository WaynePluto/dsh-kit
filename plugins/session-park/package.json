{
  "name": "@dsh-kit/dsh-plugin-session-park",
  "version": "0.1.0",
  "description": "切屏离开时把运行中的会话让位给当前工作区的空白会话，会话结束后侧栏亮「完成未读」绿点。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --max-workers 25%",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "vitest": "4.1.11"
  }
}
