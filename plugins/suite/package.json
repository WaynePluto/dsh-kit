{
  "name": "@dsh-kit/dsh-plugin-suite",
  "version": "0.0.1",
  "description": "dsh-kit 全量套件：一个包安装全部功能组件。自包含产物（自带物化 node_modules），组件声明为 peerDependencies 供宿主 runtime resolution 物理解析，本地目录与 GitHub Release tarball 安装同一产物。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "locale"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@dsh-kit/dsh-plugin-agents-md": "0.1.0",
    "@dsh-kit/dsh-plugin-chat-scroll": "0.1.0",
    "@dsh-kit/dsh-plugin-copilot-auth": "0.1.0",
    "@dsh-kit/dsh-plugin-deepseek-official-switch": "0.1.0",
    "@dsh-kit/dsh-plugin-favorite-models": "0.1.0",
    "@dsh-kit/dsh-plugin-files": "0.1.0",
    "@dsh-kit/dsh-plugin-model-capabilities": "0.1.0",
    "@dsh-kit/dsh-plugin-model-provider": "0.1.0",
    "@dsh-kit/dsh-plugin-models-catalog": "0.1.0",
    "@dsh-kit/dsh-plugin-notify": "0.1.0",
    "@dsh-kit/dsh-plugin-panel-toggle": "0.1.0",
    "@dsh-kit/dsh-plugin-proxy": "0.1.0",
    "@dsh-kit/dsh-plugin-services": "0.1.0",
    "@dsh-kit/dsh-plugin-session-rename": "0.1.0",
    "@dsh-kit/dsh-plugin-session-workspace": "0.1.0",
    "@dsh-kit/dsh-plugin-skills-inspector": "0.1.0",
    "@dsh-kit/dsh-plugin-stats-hours": "0.1.0",
    "@dsh-kit/dsh-plugin-suite-updates": "0.1.0",
    "@dsh-kit/dsh-plugin-terminal": "0.1.0",
    "@dsh-kit/dsh-plugin-tools-inspector": "0.1.0",
    "@dsh-kit/dsh-plugin-turn-retry": "0.1.0",
    "@dsh-kit/dsh-plugin-user-message-fork": "0.1.0",
    "@dsh-kit/dsh-plugin-web-search-switch": "0.1.0",
    "@dsh-kit/dsh-plugin-workspace-collapse": "0.1.0",
    "@dsh-kit/dsh-plugin-workspace-path": "0.1.0"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "scripts": {
    "test": "vitest run --max-workers 25%"
  }
}
