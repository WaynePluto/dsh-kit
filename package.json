{
  "name": "dsh-kit-root",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "plugins:build": "pnpm --filter \"./packages/plugin-ui\" --filter \"./plugins/**\" --if-present build",
    "dev:runtime": "node scripts/dev-runtime.mjs",
    "dev": "node scripts/dev-suite.mjs",
    "start": "node scripts/dev-suite.mjs --built",
    "suite:build": "node scripts/build-suite.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm -r --if-present test",
    "check:dependencies": "node scripts/check-dependency-versions.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@dsh-kit/dsh-plugin-agents-md": "workspace:*",
    "@dsh-kit/dsh-plugin-chat-scroll": "workspace:*",
    "@dsh-kit/dsh-plugin-concise-mode": "workspace:*",
    "@dsh-kit/dsh-plugin-conversation-enhancements": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-copilot-auth": "workspace:*",
    "@dsh-kit/dsh-plugin-deepseek-official-switch": "workspace:*",
    "@dsh-kit/dsh-plugin-development-tools": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-favorite-models": "workspace:*",
    "@dsh-kit/dsh-plugin-files": "workspace:*",
    "@dsh-kit/dsh-plugin-model-capabilities": "workspace:*",
    "@dsh-kit/dsh-plugin-model-enhancements": "workspace:0.1.0",
    "@dsh-kit/dsh-plugin-models-catalog": "workspace:*",
    "@dsh-kit/dsh-plugin-notify": "workspace:*",
    "@dsh-kit/dsh-plugin-preset-concise": "workspace:*",
    "@dsh-kit/dsh-plugin-prompt-filter": "workspace:*",
    "@dsh-kit/dsh-plugin-proxy": "workspace:*",
    "@dsh-kit/dsh-plugin-run-code": "workspace:*",
    "@dsh-kit/dsh-plugin-services": "workspace:*",
    "@dsh-kit/dsh-plugin-skills-inspector": "workspace:*",
    "@dsh-kit/dsh-plugin-terminal": "workspace:*",
    "@dsh-kit/dsh-plugin-tools-inspector": "workspace:*",
    "@dsh-kit/dsh-plugin-turn-retry": "workspace:*",
    "@dsh-kit/dsh-plugin-user-message-fork": "workspace:*",
    "@dsh-kit/dsh-plugin-web-search-switch": "workspace:*",
    "@dsh-kit/dsh-plugin-yolo-mode": "workspace:*",
    "@types/node": "22.20.4",
    "husky": "9.1.7",
    "immer": "10.2.0",
    "oxlint": "1.86.0",
    "pnpm": "10.17.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "zustand": "4.4.7"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "4.0.4",
